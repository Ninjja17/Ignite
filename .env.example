# Copy to .env.local. Everything is optional for a local demo with the simulated engine.

# Public URL of this app. TinyFish runs browsers in the cloud, so sandbox tasks on the TinyFish engine
# need a public tunnel here (e.g. cloudflared / ngrok). Defaults to http://localhost:$PORT.
PUBLIC_BASE_URL=
# URL the server uses to call itself (built-in demo agents). Defaults to PUBLIC_BASE_URL.
INTERNAL_BASE_URL=

# TinyFish browser engine (https://tinyfish.ai). Without a key only the simulated engine is available.
TINYFISH_API_KEY=
TINYFISH_BASE_URL=https://agent.tinyfish.ai
TINYFISH_BROWSER_PROFILE=lite

# HMAC secret used to sign requests sent to agent endpoints. Change in any shared deployment.
AGENT_SIGNING_SECRET=change-me
# When set, launching/cancelling benchmarks requires the x-admin-token header (the UI prompts for it).
OLYMPICS_ADMIN_TOKEN=

MAX_CONCURRENT_ATTEMPTS=3
MAX_ATTEMPTS_PER_BENCHMARK=60
# Used for cost efficiency when the provider does not report cost.
ESTIMATED_COST_PER_STEP_USD=0.002
# Allow http:// agent endpoints (local development only).
ALLOW_INSECURE_AGENT_ENDPOINTS=false

# Directory for the JSON store (relative to the app root, or absolute).
OLYMPICS_DATA_DIR=.data
